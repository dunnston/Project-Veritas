expression = "//Exported with UnrealToGodot : https://www.fab.com/listings/61983625-664c-4308-9b26-edfd58d41002
float saturate(float val)
{
	return clamp( val, 0.0, 1.0 );
}
vec2 saturate2(vec2 val)
{
	return clamp( val, 0.0, 1.0 );
}
vec3 saturate3(vec3 val)
{
	return clamp( val, 0.0, 1.0 );
}
vec2 mul( mat2 mat, vec2 vector )
{
	return mat * vector;
}
float rcp(float val)
{
	return 1.0 / val;
}
void sincos( float x, out float s, out float c )
{
	s = sin(x);
	c = cos(x);
}
vec2 UnitVectorToOctahedron( vec3 Nparam )
{
Nparam.xy /= vec2( dot( vec3(1.0,1.0,1.0), abs(Nparam) ), dot( vec3(1.0,1.0,1.0), abs(Nparam) ) );
if( Nparam.z <= 0.0 )
{
	vec2 val = vec2(-1,-1);	if ( Nparam.x >= 0.0 && Nparam.y >= 0.0 ) val = vec2(1,1);	Nparam.xy = ( 1.0 - abs(Nparam.yx) ) * val;
}
return Nparam.xy;
}
vec3 RotateAboutAxis(vec4 NormalizedRotationAxisAndAngle, vec3 PositionOnAxis, vec3 Position)
{
vec3 ClosestPointOnAxis = PositionOnAxis + NormalizedRotationAxisAndAngle.xyz * dot(NormalizedRotationAxisAndAngle.xyz, Position - PositionOnAxis);
vec3 UAxis = Position - ClosestPointOnAxis;
vec3 VAxis = cross(NormalizedRotationAxisAndAngle.xyz, UAxis);
float CosAngle;
float SinAngle;
sincos(NormalizedRotationAxisAndAngle.w, SinAngle, CosAngle); 
vec3 R = UAxis * CosAngle + VAxis * SinAngle;
vec3 RotatedPosition = ClosestPointOnAxis + R;
return RotatedPosition - Position;
}
vec3 hash_noise_range_UTG( vec3 p ) {
p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
return 2.0 * fract(fract(p)*4375.55) -1.;
}
"

[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_prepass_alpha;

uniform vec4 Zenith_Color = vec4(0.295000, 0.000000, 0.257272, 1.000000);
uniform sampler2D tex_frg_11 : source_color;
uniform float Stars_brightness = 0.10000000149012;
uniform float Sun_height = 1.0;
uniform vec4 Horizon_color = vec4(1.979560, 2.586640, 3.000000, 1.000000);
uniform float Horizon_Falloff = 3.0;
uniform vec4 Light_direction = vec4(0.379923, -0.402382, -0.832915, 1.000000);
uniform float Sun_Radius = 0.00030000001425;
uniform vec4 Sun_color = vec4(1.000000, 0.737910, 0.181164, 1.000000);
uniform float Sun_brightness = 50.0;
uniform vec4 Cloud_color = vec4(0.893027, 0.000000, 1.000000, 1.000000);
uniform float Cloud_speed = 0.10000000149012;
uniform sampler2D tex_frg_41 : source_color;
uniform sampler2D tex_frg_46 : source_color;
uniform vec4 ObjectRadius = vec4(100.000000, 100.000000, 100.000000, 0.000000);
uniform float Cloud_opacity = 1.0;
uniform float NoisePower1 = 1.0;
uniform float NoisePower2 = 4.0;
uniform sampler2D tex_frg_63 : source_color;
uniform vec4 Overall_Color = vec4(1.000000, 0.393145, 0.791928, 1.000000);


// GlobalExpression:0
	//Exported with UnrealToGodot : https://www.fab.com/listings/61983625-664c-4308-9b26-edfd58d41002
	float saturate(float val)
	{
		return clamp( val, 0.0, 1.0 );
	}
	vec2 saturate2(vec2 val)
	{
		return clamp( val, 0.0, 1.0 );
	}
	vec3 saturate3(vec3 val)
	{
		return clamp( val, 0.0, 1.0 );
	}
	vec2 mul( mat2 mat, vec2 vector )
	{
		return mat * vector;
	}
	float rcp(float val)
	{
		return 1.0 / val;
	}
	void sincos( float x, out float s, out float c )
	{
		s = sin(x);
		c = cos(x);
	}
	vec2 UnitVectorToOctahedron( vec3 Nparam )
	{
	Nparam.xy /= vec2( dot( vec3(1.0,1.0,1.0), abs(Nparam) ), dot( vec3(1.0,1.0,1.0), abs(Nparam) ) );
	if( Nparam.z <= 0.0 )
	{
		vec2 val = vec2(-1,-1);	if ( Nparam.x >= 0.0 && Nparam.y >= 0.0 ) val = vec2(1,1);	Nparam.xy = ( 1.0 - abs(Nparam.yx) ) * val;
	}
	return Nparam.xy;
	}
	vec3 RotateAboutAxis(vec4 NormalizedRotationAxisAndAngle, vec3 PositionOnAxis, vec3 Position)
	{
	vec3 ClosestPointOnAxis = PositionOnAxis + NormalizedRotationAxisAndAngle.xyz * dot(NormalizedRotationAxisAndAngle.xyz, Position - PositionOnAxis);
	vec3 UAxis = Position - ClosestPointOnAxis;
	vec3 VAxis = cross(NormalizedRotationAxisAndAngle.xyz, UAxis);
	float CosAngle;
	float SinAngle;
	sincos(NormalizedRotationAxisAndAngle.w, SinAngle, CosAngle); 
	vec3 R = UAxis * CosAngle + VAxis * SinAngle;
	vec3 RotatedPosition = ClosestPointOnAxis + R;
	return RotatedPosition - Position;
	}
	vec3 hash_noise_range_UTG( vec3 p ) {
	p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
	return 2.0 * fract(fract(p)*4375.55) -1.;
	}
	

void fragment() {
// Vector4Parameter:8
	vec4 n_out8p0 = Zenith_Color;


	vec2 n_out12p0;
// Expression:12
	n_out12p0 = vec2(0.0, 0.0);
	{
		//Texcoords with tiling:12(null)
		n_out12p0 = UV2 * vec2( 12.000000,12.000000 );
		
	}


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, n_out12p0);


// FloatParameter:13
	float n_out13p0 = Stars_brightness;


// VectorOp:10
	vec3 n_out10p0 = vec3(n_out11p0.xyz) * vec3(n_out13p0);


// FloatParameter:14
	float n_out14p0 = Sun_height;


// VectorOp:9
	vec3 n_out9p0 = n_out10p0 * vec3(n_out14p0);


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out8p0.xyz) + n_out9p0;


// Vector4Parameter:15
	vec4 n_out15p0 = Horizon_color;


// Input:21
	vec3 n_out21p0 = CAMERA_DIRECTION_WORLD;


// Vector3Constant:22
	vec3 n_out22p0 = vec3(0.000000, 0.000000, -1.000000);


// DotProduct:20
	float n_out20p0 = dot(n_out21p0, n_out22p0);


// Clamp:19
	float n_in19p1 = 0.00000;
	float n_in19p2 = 1.00000;
	float n_out19p0 = clamp(n_out20p0, n_in19p1, n_in19p2);


// FloatFunc:18
	float n_out18p0 = 1.0 - n_out19p0;


// FloatParameter:23
	float n_out23p0 = Horizon_Falloff;


// VectorOp:17
	vec3 n_out17p0 = pow(vec3(n_out18p0), vec3(n_out23p0));


// Clamp:16
	float n_in16p1 = 0.00000;
	float n_in16p2 = 1.00000;
	float n_out16p0 = clamp(n_out17p0.x, n_in16p1, n_in16p2);


// Mix:6
	vec3 n_out6p0 = mix(n_out7p0, vec3(n_out15p0.xyz), vec3(n_out16p0));


// Input:27
	vec3 n_out27p0 = CAMERA_DIRECTION_WORLD;


// Vector4Parameter:29
	vec4 n_out29p0 = Light_direction;


// VectorFunc:28
	vec3 n_out28p0 = normalize(vec3(n_out29p0.xyz));


// DotProduct:26
	float n_out26p0 = dot(n_out27p0, n_out28p0);


// FloatConstant:30
	float n_out30p0 = 1.000000;


// FloatParameter:31
	float n_out31p0 = Sun_Radius;


	vec3 n_out25p0;
// Expression:25
	n_out25p0 = vec3(0.0, 0.0, 0.0);
	{
		//SphereMask
		n_out25p0 = min( max( (vec3(1.0) - length( vec4(n_out26p0).xyz - vec4(n_out30p0).xyz ) * 1.0 / max( vec3(1e-05), vec3(n_out31p0,n_out31p0,n_out31p0).xyz)) * (1.0 / max(1.0 - vec3(0.000000,0.000000,0.000000).xyz, 1e-05)) , 0.0), 1.0);
		
	}


// Vector4Parameter:33
	vec4 n_out33p0 = Sun_color;


